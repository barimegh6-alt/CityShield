# Copy this file to ".env" and fill in YOUR values. Never commit ".env".
# The backend reads these as environment variables (see start-cityshield.bat).

# JDBC URL of your MySQL 8 database (database name: cityshield)
CITYSHIELD_DB_URL=jdbc:mysql://localhost:3306/cityshield?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
# Application database user
CITYSHIELD_DB_USER=cityshield_app
# Password of that user - placeholder only, set your own
CITYSHIELD_DB_PASSWORD=<your-mysql-password-here>
# Browser origins allowed to call the API (comma separated)
CITYSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
